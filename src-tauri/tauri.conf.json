{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "삼정 학사일정",
  "version": "0.3.2",
  "identifier": "kr.hs.samsung.calendarwidget",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "label": "main", "title": "삼정 학사일정", "width": 720, "height": 620, "minWidth": 360, "minHeight": 320, "decorations": false, "resizable": true, "alwaysOnTop": false, "visible": true }] },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
